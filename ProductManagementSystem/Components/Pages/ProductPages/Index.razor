@page "/products"
@using Microsoft.AspNetCore.Components.QuickGrid
@using ProductManagementSystem.DTO
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Products</PageTitle>

@if (IsLoading)
{
    <div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
        <img src="images/loading.gif" alt="loading"/>
    </div>
}
else
{
    <div class="page-size-chooser">
        Items per page:
        <select @bind="@pagination.ItemsPerPage">
            <option>5</option>
            <option>10</option>
            <option>20</option>
            <option>50</option>
        </select>
    </div>
    <div class="container-fluid">
        <h1>Products</h1>
        <QuickGrid Items="AllProducts" ItemKey="p => p.Id" Pagination="@pagination" Theme="none"
                   Class="table table-striped table-hover">
            <PropertyColumn Property="@(p => p.ProductName)" Title="Product Name" Sortable="true">
                <ColumnOptions>
                    <div class="search-box">
                        <input type="search" autofocus="autofocus" @bind="_nameSearch" @bind:event="oninput"
                               placeholder="Product name"/>
                    </div>
                </ColumnOptions>
            </PropertyColumn>
            <PropertyColumn Property="@(p => p.Category)" Sortable="true"/>
            <PropertyColumn Property="@(p => p.Price)" Sortable="true"/>
            <PropertyColumn Property="@(p => p.Quantity)" Sortable="true"/>
            <PropertyColumn Property="@(p => p.DateAdded)" Title="Date Added" Format="MM-dd-yyyy hh:mm"
                            Sortable="true"/>
            <TemplateColumn Title="Is Active?">
                <input class="form-check-input" type="checkbox" checked="@context.IsActive" disabled/>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Context="product">
                <button class="btn btn-outline-primary" @onclick="() => Edit(product.Id)">Edit</button>
                <button class="btn btn-outline-secondary" @onclick="() => Details(product.Id)">Details</button>
                <button class="btn btn-outline-danger" @onclick="() => Delete(product.Id)">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <div>
        <Paginator State="pagination"/>
    </div>
}

@code {
    private bool IsLoading { get; set; } = true;
    private QuickGrid<ProductResponse> productGrid;
    readonly PaginationState pagination = new() { ItemsPerPage = 10 };
    private string _nameSearch = string.Empty;
    private string _categorySearch = string.Empty;
    private List<string> _categories = [];
    private List<ProductResponse> _allProducts = [];
    private IQueryable<ProductResponse> AllProducts => _allProducts.AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        _allProducts = await LoadProducts();

        IsLoading = false;
    }

    private async Task<List<ProductResponse>> LoadProducts()
    {
        return await ProductService.GetAllProducts();
    }

    private void Edit(object productId)
    {
        NavigationManager.NavigateTo($"/products/edit/{productId}");
    }

    private void Details(object productId)
    {
        NavigationManager.NavigateTo($"/products/details/{productId}");
    }

    private void Delete(object productId)
    {
        NavigationManager.NavigateTo($"/products/delete/{productId}");
    }

}
